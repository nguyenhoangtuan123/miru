# ===== MIRU - Production Environment Variables =====
# For Railway deployment

# ---- PRODUCTION CONFIG ----
# MUST be set to "production" for Railway
ENVIRONMENT=production

# Comma-separated list of allowed origins (no spaces)
# For Railway deployment with same domain for frontend and backend
ALLOWED_ORIGINS=https://web-production-56fc05.up.railway.app

# ---- SUPABASE ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_DB_URL=postgresql://postgres:password@host:5432/postgres

# ---- GOOGLE AI (Gemini) ----
GOOGLE_API_KEY=your-google-api-key

# ---- GROQ AI (Optional) ----
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ---- USER INFO ----
USER_ID=user_alex
USER_NAME=Alex

# ---- MCP ----
MCP_SERVER_URL=http://127.0.0.1:8020/sse/sse

# ---- TOKEN / BUDGET CONFIG ----
MAX_OUTPUT_TOKENS=120
PROMPT_BUDGET_TOKENS=1200
ROLL_TURNS=4
MAX_CONTEXT_CHARS=600
DEBUG_TIMING=0

# ---- GOOGLE OAUTH ----
# Replace with your actual Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Use Railway domain for redirect URI
GOOGLE_REDIRECT_URI=https://web-production-56fc05.up.railway.app/auth/callback

# ---- JWT SESSION ----
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-256-bit-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=14
