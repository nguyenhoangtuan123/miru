# ===== MIRU - Environment Variables Template =====
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- SUPABASE ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_DB_URL=postgresql://postgres:password@host:5432/postgres

# ---- GOOGLE AI (Gemini) ----
GOOGLE_API_KEY=your-google-api-key

# ---- GROQ AI (Optional) ----
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ---- USER INFO ----
USER_ID=user_alex
USER_NAME=Alex

# ---- MCP ----
MCP_SERVER_URL=http://127.0.0.1:8020/sse/sse

# ---- WEB PUSH / PWA ----
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIMS_SUBJECT=mailto:notifications@miru.app
ENABLE_PROACTIVE_PUSH=true
PROACTIVE_PUSH_INACTIVITY_HOURS=12
PROACTIVE_PUSH_POLL_MINUTES=15

# ---- TOKEN / BUDGET CONFIG ----
MAX_OUTPUT_TOKENS=120
PROMPT_BUDGET_TOKENS=1200
ROLL_TURNS=4
MAX_CONTEXT_CHARS=600
DEBUG_TIMING=0

# ---- GOOGLE OAUTH ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8008/auth/callback

# ---- JWT SESSION ----
# IMPORTANT: Generate a new secret for production!
# Run: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-new-256-bit-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=14

# ---- PRODUCTION CONFIG ----
# Set to "production" on deployed server
ENVIRONMENT=development
# Comma-separated list of allowed origins (no spaces)
# Example: https://miru.yourdomain.com,https://app.miru.com
ALLOWED_ORIGINS=http://localhost:8008,http://127.0.0.1:8008
